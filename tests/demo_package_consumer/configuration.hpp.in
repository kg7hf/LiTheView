#pragma once

#include "demo.hpp"

inline constexpr auto kFormat = lithe::PixelFormat::@expected_format@;
inline constexpr std::uint32_t kExpectedCrc = @expected_crc@;
static_assert(lithe::supportsDestination(kFormat));
static_assert(lithe::demo::config::kFontBackend == lithe::BuiltInFontBackend::@expected_font@);
static_assert(lithe::demo::config::kAnimationFormat == lithe::demo::GallopResourceFormat::@expected_animation@);

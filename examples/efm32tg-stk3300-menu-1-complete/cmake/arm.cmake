set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GCC_BIN "$ENV{ARM_GCC_BIN}" CACHE PATH "Directory containing arm-none-eabi-gcc")
include("${CMAKE_CURRENT_LIST_DIR}/find_tools.cmake")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GCC_BIN TINY_NINJA)
set(tiny_arm_override "")
if(ARM_GCC_BIN)
    set(tiny_arm_override "${ARM_GCC_BIN}/arm-none-eabi-gcc")
    if(CMAKE_HOST_WIN32)
        string(APPEND tiny_arm_override ".exe")
    endif()
endif()
tiny_find_tool(CMAKE_C_COMPILER arm-none-eabi-gcc "${tiny_arm_override}"
    "$ENV{USERPROFILE}/.mcuxpressotools/arm-gnu-toolchain-*/bin/arm-none-eabi-gcc.exe"
    "$ENV{LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/*/bin/arm-none-eabi-gcc.exe")
get_filename_component(arm_bin "${CMAKE_C_COMPILER}" DIRECTORY)
tiny_find_ninja("${arm_bin}")
if(CMAKE_HOST_WIN32)
    set(ENV{PATH} "${arm_bin};$ENV{PATH}")
    set(CMAKE_C_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;--modify;PATH=path_list_prepend:${arm_bin};--")
    set(CMAKE_CXX_COMPILER_LAUNCHER "${CMAKE_C_COMPILER_LAUNCHER}")
    set(CMAKE_CXX_LINKER_LAUNCHER "${CMAKE_C_COMPILER_LAUNCHER}")
endif()
find_program(CMAKE_CXX_COMPILER arm-none-eabi-g++ HINTS "${arm_bin}" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${arm_bin}" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${arm_bin}" NO_DEFAULT_PATH REQUIRED)
set(TINY_GECKO_EMBEDDED ON CACHE BOOL "Build PCB2100 A03 firmware")

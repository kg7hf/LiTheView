# Application-owned adapter for the designer's optional host front-view sidecar.
# This module is included only in the Win32 build; the MCU never reads the photo.
set(front_file "${CMAKE_CURRENT_SOURCE_DIR}/Tasks/UI/project.litheview.front-panel.json")
file(GLOB front_files CONFIGURE_DEPENDS "${front_file}")
set(front_enabled false)
set(front_image_width 390)
set(front_image_height 390)
set(front_window_width 390)
set(front_window_height 390)
set(front_display "0, 0, 390, 390")
set(front_button_count 0)
set(front_buttons "")

function(front_integer output minimum maximum)
    string(JSON value GET "${front_json}" ${ARGN})
    if(NOT value MATCHES "^[0-9]+$" OR value LESS minimum OR value GREATER maximum)
        message(FATAL_ERROR "Invalid front-view ${ARGN}: expected ${minimum}..${maximum}. Reopen Configure.")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(front_area output)
    front_integer(x 0 8192 ${ARGN} x)
    front_integer(y 0 8192 ${ARGN} y)
    front_integer(w 1 8192 ${ARGN} width)
    front_integer(h 1 8192 ${ARGN} height)
    math(EXPR right "${x} + ${w}")
    math(EXPR bottom "${y} + ${h}")
    if(right GREATER front_image_width OR bottom GREATER front_image_height)
        message(FATAL_ERROR "Front-view region ${ARGN} lies outside its image.")
    endif()
    math(EXPR pixel_width "${right} * ${front_window_width} / ${front_image_width} - ${x} * ${front_window_width} / ${front_image_width}")
    math(EXPR pixel_height "${bottom} * ${front_window_height} / ${front_image_height} - ${y} * ${front_window_height} / ${front_image_height}")
    if(pixel_width LESS 1 OR pixel_height LESS 1)
        message(FATAL_ERROR "Front-view region ${ARGN} disappears at the selected window width.")
    endif()
    set(${output} "${x}, ${y}, ${w}, ${h}" PARENT_SCOPE)
endfunction()

function(front_disjoint first second)
    string(REPLACE ", " ";" a "${first}")
    string(REPLACE ", " ";" b "${second}")
    list(GET a 0 ax)
    list(GET a 1 ay)
    list(GET a 2 aw)
    list(GET a 3 ah)
    list(GET b 0 bx)
    list(GET b 1 by)
    list(GET b 2 bw)
    list(GET b 3 bh)
    math(EXPR ar "${ax}+${aw}")
    math(EXPR ab "${ay}+${ah}")
    math(EXPR br "${bx}+${bw}")
    math(EXPR bb "${by}+${bh}")
    if(ax LESS br AND bx LESS ar AND ay LESS bb AND by LESS ab)
        message(FATAL_ERROR "Front-view display and push-button areas must not overlap.")
    endif()
endfunction()

if(front_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${front_file}")
    file(SIZE "${front_file}" front_bytes)
    if(front_bytes GREATER 65536)
        message(FATAL_ERROR "Front-view settings exceed 64 KiB.")
    endif()
    file(READ "${front_file}" front_json)
    front_integer(version 1 1 schemaVersion)
    string(JSON enabled_type TYPE "${front_json}" enabled)
    if(NOT enabled_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "Front-view enabled must be a boolean.")
    endif()
    string(JSON show_front GET "${front_json}" enabled)
    if(show_front)
        set(front_enabled true)
        front_integer(front_image_width 1 8192 image width)
        front_integer(front_image_height 1 8192 image height)
        math(EXPR image_pixels "${front_image_width} * ${front_image_height}")
        if(image_pixels GREATER 16777216)
            message(FATAL_ERROR "Front-view PNG exceeds 16 megapixels.")
        endif()
        front_integer(front_window_width 160 4096 windowWidth)
        math(EXPR front_window_height "(${front_window_width} * ${front_image_height} + ${front_image_width} / 2) / ${front_image_width}")
        if(front_window_height LESS 1 OR front_window_height GREATER 4096)
            message(FATAL_ERROR "Invalid front-view window height.")
        endif()
        front_area(front_display display)
        string(JSON front_button_count LENGTH "${front_json}" buttons)
        if(front_button_count GREATER 16)
            message(FATAL_ERROR "At most 16 front-view buttons are supported.")
        endif()
        set(front_ids "")
        if(front_button_count GREATER 0)
            math(EXPR last "${front_button_count} - 1")
            foreach(index RANGE ${last})
                string(JSON id GET "${front_json}" buttons ${index} id)
                string(LENGTH "${id}" id_length)
                if(NOT id MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR id_length GREATER 48 OR id IN_LIST front_ids)
                    message(FATAL_ERROR "Invalid or duplicate front-view button name.")
                endif()
                # This example maps the photo hotspot to joystick-center selection.
                if(NOT id STREQUAL "userButton")
                    message(FATAL_ERROR "No device adapter for '${id}'. This example maps userButton to joystick center.")
                endif()
                list(APPEND front_ids "${id}")
                front_area(bounds buttons ${index} bounds)
                front_disjoint("${front_display}" "${bounds}")
                string(APPEND front_buttons "NamedButton{\"${id}\", Area{${bounds}}},")
            endforeach()
        endif()
        string(JSON image_relative GET "${front_json}" image path)
        if(IS_ABSOLUTE "${image_relative}")
            message(FATAL_ERROR "Front-view image must be relative to the application root.")
        endif()
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}/${image_relative}" image_path)
        file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" application_path)
        cmake_path(IS_PREFIX application_path "${image_path}" NORMALIZE contained)
        if(NOT contained OR NOT EXISTS "${image_path}" OR IS_DIRECTORY "${image_path}")
            message(FATAL_ERROR "Front-view image must be a file inside the application.")
        endif()
        file(SIZE "${image_path}" image_size)
        if(image_size GREATER 16777216)
            message(FATAL_ERROR "Front-view PNG exceeds 16 MiB.")
        endif()
        file(SHA256 "${image_path}" image_hash)
        string(JSON expected_hash GET "${front_json}" image sha256)
        if(NOT image_hash STREQUAL expected_hash)
            message(FATAL_ERROR "The front-view PNG changed. Choose it again in Configure and Apply.")
        endif()
        configure_file("${image_path}" "${CMAKE_CURRENT_BINARY_DIR}/board-front.png" COPYONLY)
    endif()
endif()
configure_file(cmake/front_panel.hpp.in generated/front_panel_config.hpp @ONLY)
target_include_directories(starter PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_sources(starter PRIVATE Platform/Win32/front_panel.cpp)
target_link_libraries(starter PRIVATE gdiplus)

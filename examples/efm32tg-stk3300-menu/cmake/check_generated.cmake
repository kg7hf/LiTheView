set(header "${TINY_SOURCE}/UI/Generated/segmented/home.hpp")
if(NOT EXISTS "${header}")
    message(FATAL_ERROR "Open UI/designer/forms/home.litheview.xml and Generate UI before building.")
endif()
file(READ "${header}" generated)
function(check_input label relative)
    file(READ "${TINY_SOURCE}/${relative}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    string(SHA256 hash "${source}")
    string(FIND "${generated}" "// ${label} input (LF) SHA-256: ${hash}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Generated UI is stale for ${relative}. Save the project and click Generate UI, then build again.")
    endif()
endfunction()
check_input(Project UI/designer/project.litheview.json)
check_input(Glass UI/designer/profiles/glass.segment-display.json)
check_input(Input UI/designer/profiles/logical-input.json)
check_input(Form UI/designer/forms/home.litheview.xml)

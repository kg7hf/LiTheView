{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litheview.dev/schema/target-evidence.schema.json",
  "title": "LitheView target feasibility evidence and integration choices",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1, "default": 1 },
    "expectedDisplayDefinitionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "expectedFormSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "expectedDisplayDefinitionSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "expectedLogicalInputSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "resourcePlacement": { "enum": [null, "internalFlash", "externalQspi", "hostFile", "applicationProvider"] },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "kind", "source"],
        "properties": {
          "metric": { "enum": [
            "archiveTextBytes", "initializedDataBytes", "bssBytes", "stackFrameBytes",
            "staticObjectBytes", "tileWorkspaceAllocatedBytes", "framebufferAllocatedBytes",
            "internalFlashBytes", "internalRamBytes", "externalRamBytes", "damageRegionCount",
            "controllerDepthCount", "transferWireBytes", "transferDurationMicroseconds"
          ] },
          "value": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "kind": { "enum": ["calculated", "estimated", "crossBuildMeasured", "hardwareMeasured"] },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "transferLimits": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "anyOf": [
            { "required": ["maximumWireBytes"], "properties": { "maximumWireBytes": { "type": "integer" } } },
            { "required": ["maximumDurationMicroseconds"], "properties": { "maximumDurationMicroseconds": { "type": "integer" } } }
          ],
          "properties": {
            "maximumWireBytes": { "type": ["integer", "null"], "minimum": 1, "maximum": 9223372036854775807 },
            "maximumDurationMicroseconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 9223372036854775807 },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ]
    }
  },
  "$defs": {
    "source": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litheview.dev/schema/segment-glass.schema.json",
  "title": "LiTheView segmented glass version 1",
  "description": "Host geometry and logical electrodes. Semantic checks also enforce field mappings, glyph completeness, viewport containment and per-form exclusive writers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "segmentCount",
    "viewWidth",
    "viewHeight",
    "shapes",
    "icons",
    "groups",
    "texts",
    "numbers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
    },
    "segmentCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "viewWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "viewHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/shape"
      }
    },
    "icons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/icon"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "texts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "numbers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/number"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "polygon"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "segments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "uniqueItems": true
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "segments",
        "maximum"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "uniqueItems": true
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "strokes"
      ],
      "properties": {
        "character": {
          "type": "string",
          "pattern": "^[ -~]$"
        },
        "strokes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "uniqueItems": true
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cells",
        "glyphs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          }
        },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 95,
          "items": {
            "$ref": "#/$defs/glyph"
          }
        }
      }
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cells",
        "glyphs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          }
        },
        "glyphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 95,
          "items": {
            "$ref": "#/$defs/glyph"
          }
        }
      }
    }
  }
}
